<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="550.0" minWidth="780.0" prefHeight="550.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="agh.ics.oop.presenter.SimulationPresenter">
   <top>
      <HBox alignment="CENTER" prefHeight="56.0" prefWidth="506.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="5.0" />
         </BorderPane.margin>
      </HBox>
   </top>
   <center>
      <Canvas fx:id="canvas" height="400.0" width="600.0" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
       <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
       <children>
      <Label fx:id="animalMovementLabel" text="aktualny ruch zwierzaka"/>
          <Button fx:id="pauseButton" text="Stop / Start" onAction="#pauseButtonClicked"/>
           </children>
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
       </VBox>
   </bottom>
</BorderPane>

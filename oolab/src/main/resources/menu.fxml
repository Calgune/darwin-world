<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="800.0" minWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="agh.ics.oop.presenter.SimulationPresenter">
    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Panel parametrów" />

                <GridPane alignment="CENTER" hgap="30.0" prefHeight="428.0" prefWidth="560.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" minWidth="200.0" />
                        <ColumnConstraints halignment="CENTER" minWidth="200.0" />
                    </columnConstraints>

                    <children>
                        <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Szerokość mapy:" />
                            <TextField fx:id="mapWidthTextField" maxWidth="100.0" text="25" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 10-45)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Wysokość mapy:" />
                            <TextField fx:id="mapHeightTextField" maxWidth="100.0" text="12" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 5-20)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Długość genomu:" />
                            <TextField fx:id="genomesTextField" maxWidth="100.0" text="7" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: &gt;0)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="Początkowa ilość zwierząt:" />
                            <TextField fx:id="animalsCntTextField" maxWidth="100.0" text="15" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: &lt; 1/2 pól)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="4">
                            <Label text="Początkowa energia:" />
                            <TextField fx:id="initialEnergyTextField" maxWidth="100.0" text="100" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 50-200)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="5">
                            <Label text="Ile energii ubywa dziennie:" />
                            <TextField fx:id="dailyEnergyDecay" maxWidth="100.0" text="12" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 1-5)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Początkowa liczba roślin:" />
                            <TextField fx:id="initialGrassesTextField" maxWidth="100.0" text="30" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: &lt; 1/2 pól)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Ile dodawać roślin dziennie:" />
                            <TextField fx:id="dailyGrassesTextField" maxWidth="100.0" text="7" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: &lt; 1/4 pól)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Próg energii do prokreacji:" />
                            <TextField fx:id="breedingThreshold" maxWidth="100.0" text="12" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 15-30)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label text="Koszt prokreacji:" />
                            <TextField fx:id="breedingCost" maxWidth="100.0" text="10" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 5-20)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <Label text="Energia z trawy:" />
                            <TextField fx:id="fromGrassEnergy" maxWidth="100.0" text="2" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 1-5)" />
                        </VBox>

                        <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="5">
                            <Label text="Ile trwa ruch zwierzaka (ms):" />
                            <TextField fx:id="refreshTimeTextField" maxWidth="100.0" text="100" />
                            <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 100-1000)" />
                        </VBox>

                    </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
                </GridPane>
                   <CheckBox fx:id="simulationTypeCheckButton" mnemonicParsing="false" onAction="#simulationTypeCheckButtonClicked" selected="true" text="Pory roku">
               <VBox.margin>
                  <Insets bottom="10.0" top="-20.0" />
               </VBox.margin></CheckBox>
            <GridPane hgap="30.0" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="SOMETIMES" />
                <RowConstraints vgrow="SOMETIMES" />
              </rowConstraints>
               <children>

                    <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Minimalna temperatura w zimę (°C):" />
                        <TextField fx:id="minimalTemperatureTextField" maxWidth="100.0" text="0" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 10 do -20)" />
                    </VBox>

                   <VBox alignment="CENTER" prefWidth="214.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                       <Label text="Odległość aby zwierzak mógł się ogrzać:" />
                       <TextField fx:id="distanceToTransferHeatTextField" maxWidth="100.0" text="2" />
                       <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 2 do 5)" />
                   </VBox>

                    <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Długość lata:" />
                        <TextField fx:id="summerLengthTextField" maxWidth="100.0" text="50" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 50-100)" />
                    </VBox>

                    <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Długość zimy (dni):" />
                        <TextField fx:id="winterLengthTextField" maxWidth="100.0" text="50" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="(Sugerowane: 50-100)" />
                    </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </GridPane>

                <HBox alignment="CENTER" spacing="15.0">
                    <ComboBox fx:id="presetComboBox" onAction="#selectPresets" prefWidth="150.0" promptText="Presety" />
                    <Button onAction="#saveConfiguration" text="Zapisz do pliku" />
                    <Button onAction="#loadConfiguration" text="Wczytaj z pliku" />
                    <Button fx:id="startButton" onAction="#onSimulationStartClicked" prefWidth="120.0" text="Start" />
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>

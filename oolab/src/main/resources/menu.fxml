<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="300.0" minWidth="400.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="agh.ics.oop.presenter.SimulationPresenter">
    <center>
        <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold;" text="Panel parametrow" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="Dlugosc genomu:" />
                        <TextField fx:id="movementsTextField" prefWidth="100.0" text="7" />
                    </children>
                </HBox>
                <Button fx:id="startButton" mnemonicParsing="false" onAction="#onSimulationStartClicked" prefHeight="30.0" prefWidth="120.0" text="Start" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>